+        </dl>
+        <p class="field-help" th:if="${order.status == 'PENDING_PAYMENT'}" data-order-pending-note>当前订单待支付，商品信息与金额以本单成交记录为准。</p>
+        <p class="field-help" th:unless="${order.status == 'PENDING_PAYMENT'}">当前展示已记录的订单状态与历史信息。</p>
+    </section>
+
+    <section class="order-items" aria-labelledby="order-items-title">
