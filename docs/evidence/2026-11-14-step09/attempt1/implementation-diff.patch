+                            <div>
+                                <strong th:text="${line.productNameSnapshot}">成交商品名称</strong>
+                                <p class="field-help order-sku">SKU：<span th:text="${line.skuSnapshot}">SKU</span></p>
+                            </div>
+                        </div>
+                    </td>
+                    <td class="orders-money" th:text="${'¥' + #numbers.formatDecimal(line.unitPrice,1,'NONE',2,'POINT')}">¥0.00</td>
+                    <td th:text="${line.quantity}">0</td>
+                    <td class="orders-money"><strong th:text="${'¥' + #numbers.formatDecimal(line.lineAmount,1,'NONE',2,'POINT')}">¥0.00</strong></td>
+                </tr>
+                </tbody>
+            </table>
+        </div>
+    </section>
+
+    <div class="order-detail-grid">
