+                <div><dt>联系电话</dt><dd data-shipping-value="receiverPhone" data-shipping-phone th:text="${order.receiverPhone}">[REDACTED]</dd></div>
+                <div><dt>完整地址</dt><dd data-shipping-value="receiverAddress" data-shipping-address th:text="${order.receiverAddress}">[REDACTED]</dd></div>
