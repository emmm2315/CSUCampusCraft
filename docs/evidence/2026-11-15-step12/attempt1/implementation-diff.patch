+        <dl class="customer-profile-grid"><div><dt>顾客 ID</dt><dd data-customer-id-value th:text="${customer.id}">0</dd></div><div><dt>用户名</dt><dd data-customer-username th:text="${customer.username}">用户名</dd></div><div><dt>显示名</dt><dd data-customer-display-name th:text="${customer.displayName}">显示名</dd></div><div><dt>创建时间</dt><dd><time data-customer-created-at th:text="${customer.createdAtDisplay}">创建时间</time>（北京时间）</dd></div><div><dt>教学邮箱</dt><dd data-customer-contact="email" th:text="${customer.email == null or #strings.isEmpty(#strings.trim(customer.email)) ? '未填写' : customer.email}">[REDACTED-CONTACT]</dd></div><div><dt>教学电话</dt><dd data-customer-contact="phone" th:text="${customer.phone == null or #strings.isEmpty(#strings.trim(customer.phone)) ? '未填写' : customer.phone}">[REDACTED-CONTACT]</dd></div></dl>
