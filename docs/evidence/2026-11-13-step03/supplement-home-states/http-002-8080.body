<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CSUCampusCraft 用户端</title>
    <link rel="stylesheet" href="/css/app.css">
    <script defer src="/js/app.js"></script>
</head>
<body data-csucampuscraft-app="user">
<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
    <div class="container site-header-inner">
        <a class="site-brand" href="/" aria-label="CSUCampusCraft 首页">
            <span class="brand-mark" aria-hidden="true">CSU</span>
            <span>CSUCampusCraft 用户端</span>
        </a>
        <nav class="site-nav" aria-label="站点导航">
            <a href="/">首页</a>
            <span class="app-label">用户端</span>
            <span class="nav-placeholder" aria-label="购物车，0 件">
                购物车 <span id="cart-quantity" class="quantity-badge"
                           data-cart-quantity="0">0</span>
            </span>
        </nav>
    </div>
</header>
<div class="container global-alerts" aria-label="全局提示区">
    
    
    

</div>
<main id="main-content" class="container main-content" tabindex="-1">
    <div class="catalog-home" data-page-id="U01">
    <header class="catalog-home-heading page-heading">
        <div>
            <p class="eyebrow">中南大学校园文创</p>
            <h1>CSUCampusCraft 用户端</h1>
            <p class="muted">按校园主题发现文具和纪念周边。</p>
        </div>
        <form class="catalog-search" method="get" action="/products" role="search">
            <label for="home-query">搜索校园文创</label>
            <div class="catalog-search-controls">
                <input id="home-query" type="search" name="q" placeholder="输入商品名称" aria-describedby="home-query-help">
                <button type="submit">搜索</button>
            </div>
            <p id="home-query-help" class="field-help">最多 120 个字符</p>
        </form>
    </header>

    <section class="graduation-banner" aria-labelledby="graduation-heading" data-graduation-section>
        <div>
            <p class="eyebrow">毕业专区</p>
            <h2 id="graduation-heading">毕业纪念专区</h2>
            <p>毕业留言本、祝福卡片与独立成品礼盒。</p>
        </div>
        <a class="button graduation-link"
           href="/products?categoryId=5&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
           data-graduation-link>浏览毕业纪念</a>
    </section>

    <section class="panel catalog-section" aria-labelledby="themes-heading">
        <div class="section-heading">
            <div>
                <h2 id="themes-heading">校园主题</h2>
                <p class="muted" data-theme-count="5">
                    共 <span>5</span> 个一级主题
                </p>
            </div>
            <a href="/products">浏览全部商品</a>
        </div>
        
        <ul class="theme-list catalog-themes">
            <li data-theme-code="LANDMARK">
                <a class="theme-primary"
                   href="/products?categoryId=1&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6">校园地标</a>
                <div class="theme-type-links">
                    <a href="/products?categoryId=1&amp;type=STATIONERY&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="LANDMARK_STATIONERY" data-secondary-category-code="LANDMARK_STATIONERY">文具</a><a href="/products?categoryId=1&amp;type=SOUVENIR&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="LANDMARK_SOUVENIR" data-secondary-category-code="LANDMARK_SOUVENIR">纪念周边</a>
                </div>
            </li>
            <li data-theme-code="COLLEGE">
                <a class="theme-primary"
                   href="/products?categoryId=2&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6">学院风采</a>
                <div class="theme-type-links">
                    <a href="/products?categoryId=2&amp;type=STATIONERY&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="COLLEGE_STATIONERY" data-secondary-category-code="COLLEGE_STATIONERY">文具</a><a href="/products?categoryId=2&amp;type=SOUVENIR&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="COLLEGE_SOUVENIR" data-secondary-category-code="COLLEGE_SOUVENIR">纪念周边</a>
                </div>
            </li>
            <li data-theme-code="CLUB">
                <a class="theme-primary"
                   href="/products?categoryId=3&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6">社团活动</a>
                <div class="theme-type-links">
                    <a href="/products?categoryId=3&amp;type=STATIONERY&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="CLUB_STATIONERY" data-secondary-category-code="CLUB_STATIONERY">文具</a><a href="/products?categoryId=3&amp;type=SOUVENIR&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="CLUB_SOUVENIR" data-secondary-category-code="CLUB_SOUVENIR">纪念周边</a>
                </div>
            </li>
            <li data-theme-code="SPORTS">
                <a class="theme-primary"
                   href="/products?categoryId=4&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6">校园运动</a>
                <div class="theme-type-links">
                    <a href="/products?categoryId=4&amp;type=STATIONERY&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="SPORTS_STATIONERY" data-secondary-category-code="SPORTS_STATIONERY">文具</a><a href="/products?categoryId=4&amp;type=SOUVENIR&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="SPORTS_SOUVENIR" data-secondary-category-code="SPORTS_SOUVENIR">纪念周边</a>
                </div>
            </li>
            <li data-theme-code="GRADUATION">
                <a class="theme-primary"
                   href="/products?categoryId=5&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6">毕业纪念</a>
                <div class="theme-type-links">
                    <a href="/products?categoryId=5&amp;type=STATIONERY&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="GRADUATION_STATIONERY" data-secondary-category-code="GRADUATION_STATIONERY">文具</a><a href="/products?categoryId=5&amp;type=SOUVENIR&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6"
                       data-secondary-code="GRADUATION_SOUVENIR" data-secondary-category-code="GRADUATION_SOUVENIR">纪念周边</a>
                </div>
            </li>
        </ul>
    </section>

    <section class="catalog-section" aria-labelledby="newest-heading" data-section="newest">
        <div class="section-heading">
            <div><p class="eyebrow">校园新品</p><h2 id="newest-heading">新品上架</h2></div>
            <a href="/products?type=ALL&amp;sort=NEWEST&amp;page=1&amp;size=6">查看全部新品</a>
        </div>
        <p class="empty-state">暂无可售商品，稍后再来看看。</p>
        
    </section>

    <section class="catalog-section" aria-labelledby="featured-heading" data-section="featured">
        <div class="section-heading">
            <div><p class="eyebrow">日常文创</p><h2 id="featured-heading">精选推荐</h2></div>
            <a href="/products?type=ALL&amp;sort=DEFAULT&amp;page=1&amp;size=6">浏览全部商品</a>
        </div>
        <p class="empty-state">暂无可售商品，可稍后再来看看。</p>
        
    </section>
</div>
</main>
<footer class="site-footer">
    <div class="container">
        <span>CSUCampusCraft 校园文创商城</span>
        <span class="muted">课程实验 · 教学模拟</span>
    </div>
</footer>
</body>
</html>
