    <link rel="stylesheet" href="/css/app.css">
    <script defer src="/js/app.js"></script>
</head>
<body data-csucampuscraft-app="user">
<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
    <div class="container site-header-inner">
        <a class="site-brand" href="/" aria-label="CSUCampusCraft 首页">
            <span class="brand-mark" aria-hidden="true">CSU</span>
            <span>CSUCampusCraft 用户端</span>
        </a>
        <nav class="site-nav" aria-label="站点导航">
            <a href="/">首页</a>
            <span class="app-label">用户端</span>
            <span class="nav-placeholder" aria-label="购物车，0 件">
                购物车 <span id="cart-quantity" class="quantity-badge"
                           data-cart-quantity="0">0</span>
            </span>
        </nav>
    </div>
</header>
<div class="container global-alerts" aria-label="全局提示区">
    
    
    

</div>
<main id="main-content" class="container main-content" tabindex="-1">
    <div class="catalog-detail-page" data-page-id="U03" data-product-id="36" data-product-sku="CSU-CLB-STAND-01" data-price="29.00" data-stock="7" data-gallery-count="0">
    <nav class="catalog-breadcrumb" aria-label="当前位置">
        <a href="/">首页</a><span aria-hidden="true">/</span>
        <a href="/products">商品</a><span aria-hidden="true">/</span>
        <a href="/products?categoryId=3&amp;type=ALL&amp;q=&amp;sort=DEFAULT&amp;page=1&amp;size=6">社团活动</a>
        <span aria-hidden="true">/</span><span>纪念周边</span>
        <span aria-hidden="true">/</span><span aria-current="page">校园演出亚克力立牌</span>
    </nav>

    <section class="catalog-detail-main" aria-labelledby="product-heading">
        <figure class="catalog-cover" data-cover-image>
            <img class="catalog-image" width="400" height="300" loading="lazy"
     src="/images/demo-missing.svg" alt="校园演出亚克力立牌" data-image-fallback="/images/catalog-placeholder.svg">
        </figure>
        <div class="catalog-detail-info">
            <p class="eyebrow">社团活动 / 纪念周边</p>
            <h1 id="product-heading">校园演出亚克力立牌</h1>
            <p class="muted catalog-sku">SKU：<span>CSU-CLB-STAND-01</span></p>
            <p class="catalog-detail-summary muted">覆盖封面资源缺失的教学场景，页面应回退到默认占位图。</p>
            <p class="product-price detail-price">¥29.00</p>
            <p class="stock-badge">现货 · 库存 7</p>
            <div class="catalog-purchase-disabled" aria-labelledby="purchase-heading">
                <!-- STEP07 接入：本步只读，不注册加购 POST，也不跳转登录。 -->
                <h2 id="purchase-heading">选购</h2>
                <label for="purchase-quantity">数量</label>
                <input id="purchase-quantity" type="number" min="1" value="1" disabled aria-describedby="purchase-help">
                <button type="button" disabled aria-describedby="purchase-help">加入购物车</button>
                <p id="purchase-help" class="field-help">暂未开放</p>
            </div>
        </div>
    </section>

    <section class="panel catalog-section catalog-description" aria-labelledby="description-heading">
        <h2 id="description-heading">设计说明</h2>
        <p class="catalog-plain-text">覆盖封面资源缺失的教学场景，页面应回退到默认占位图。 商品和价格均为教学演示数据。</p>
        
    </section>

    <section class="catalog-section" aria-labelledby="gallery-heading">
        <div class="section-heading">
            <div><h2 id="gallery-heading">商品相册</h2><p class="muted">共 <span>0</span> 张图片</p></div>
        </div>
        <p class="empty-state" data-gallery-empty>暂无相册，当前显示商品封面。</p>
        <div class="catalog-gallery" data-product-gallery>
            
        </div>
    </section>
</div>
</main>
<footer class="site-footer">
