<main id="main-content" class="container main-content" tabindex="-1">
    <div class="catalog-list-page" data-page-id="U02" data-product-count="10" data-result-count="10" data-page="1" data-page-size="50" data-size="50" data-category-id="5" data-type="ALL" data-sort="DEFAULT">
    <nav class="catalog-breadcrumb" aria-label="当前位置">
        <a href="/">首页</a><span aria-hidden="true">/</span><span aria-current="page">商品目录</span>
