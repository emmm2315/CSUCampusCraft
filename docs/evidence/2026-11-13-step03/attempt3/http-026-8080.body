            <span class="stock-badge stock-sold-out">售罄</span>
        </div>
    </div>
</article>
    </div>

    <nav class="catalog-pagination" aria-label="商品分页">
        <a class="button button-secondary" href="/products?categoryId=&amp;type=ALL&amp;q=&amp;sort=PRICE_DESC&amp;page=1&amp;size=50" data-page-link="1">上一页</a>
        
        <span class="pagination-position">第 <strong>2</strong> 页 / 共 <span>2</span> 页</span>
        
        <span class="pagination-disabled" aria-disabled="true">下一页</span>
    </nav>
</div>
</main>
<footer class="site-footer">
    <div class="container">
        <span>CSUCampusCraft 校园文创商城</span>
