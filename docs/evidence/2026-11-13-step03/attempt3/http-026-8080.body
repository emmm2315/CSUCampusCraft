    <a class="product-card-image" href="/products/29" aria-label="查看 社团读书会纸质书签">
        <img class="catalog-image" width="400" height="300" loading="lazy"
     src="/images/catalog-placeholder.svg" alt="社团读书会纸质书签" data-image-fallback="/images/catalog-placeholder.svg">
    </a>
    <div class="product-card-body">
        <p class="product-card-sku muted">CSU-CLB-BOOKMARK-01</p>
        <h3><a href="/products/29">社团读书会纸质书签</a></h3>
        <p class="product-card-summary muted">上架售罄示例。</p>
        <div class="product-card-meta">
