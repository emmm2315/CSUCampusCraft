+            <p class="muted catalog-sku">SKU：<span th:text="${product.sku}">SKU</span></p>
+            <p class="catalog-detail-summary muted" th:if="${!#strings.isEmpty(product.summary)}" th:text="${product.summary}">商品简介</p>
+            <p class="product-price detail-price" th:text="${'¥' + #numbers.formatDecimal(product.price,1,'NONE',2,'POINT')}">¥0.00</p>
+            <p class="stock-badge" th:classappend="${product.stock == 0 ? 'stock-sold-out' : ''}"
+               th:text="${product.stock == 0 ? '售罄 · 库存 0' : '现货 · 库存 ' + product.stock}">库存</p>
