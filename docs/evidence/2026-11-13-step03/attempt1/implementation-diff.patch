diff --git a/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/catalog/CatalogQuery.java b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/catalog/CatalogQuery.java
new file mode 100644
index 0000000..cd6f385
