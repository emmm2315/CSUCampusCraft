diff --git a/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/web/CatalogController.java b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/web/CatalogController.java
new file mode 100644
index 0000000..f9c38c7
