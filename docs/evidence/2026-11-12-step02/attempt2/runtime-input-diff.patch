diff --git a/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/CsrfFilter.java b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/CsrfFilter.java
new file mode 100644
index 0000000..1d7d5f9
--- /dev/null
+++ b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/CsrfFilter.java
@@ -0,0 +1,114 @@
+package org.csucampuscraft.storefront.foundation.security;
+
+import org.csucampuscraft.storefront.foundation.web.PageModelAdvice;
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import java.io.IOException;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.springframework.beans.factory.ObjectProvider;
+import org.springframework.core.Ordered;
+import org.springframework.core.annotation.Order;
+import org.springframework.stereotype.Component;
+import org.springframework.web.filter.OncePerRequestFilter;
+import org.springframework.web.servlet.View;
+import org.thymeleaf.spring6.view.ThymeleafViewResolver;
+
+/** Protects every external non-GET request, including login forms added in STEP04. */
+@Component
+@Order(Ordered.HIGHEST_PRECEDENCE + 20)
+public final class CsrfFilter extends OncePerRequestFilter {
+    private final CsrfTokenService tokens;
+    private final ObjectProvider<ThymeleafViewResolver> views;
+    private final ObjectProvider<PageModelAdvice> pageModels;
+
+    public CsrfFilter(CsrfTokenService tokens, ObjectProvider<ThymeleafViewResolver> views,
+                      ObjectProvider<PageModelAdvice> pageModels) {
+        this.tokens = tokens;
+        this.views = views;
+        this.pageModels = pageModels;
+    }
+
+    @Override
+    protected boolean shouldNotFilter(HttpServletRequest request) {
+        return "GET".equals(request.getMethod());
+    }
+
+    @Override
+    protected boolean shouldNotFilterErrorDispatch() { return true; }
+
+    @Override
+    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response,
+                                    FilterChain chain) throws ServletException, IOException {
+        if (!valid(request)) {
+            renderForbidden(request, response);
+            return;
+        }
+        chain.doFilter(request, response);
+    }
+
+    private void renderForbidden(HttpServletRequest request, HttpServletResponse response)
+            throws ServletException {
+        try {
+            Map<String, Object> model = new LinkedHashMap<>(pageModels.getObject().commonModel(request));
+            model.put("errorStatus", HttpServletResponse.SC_FORBIDDEN);
+            model.put("errorCode", "CSRF_REJECTED");
+            model.put("errorMessage", "请求校验失败，请重新打开页面后提交。");
+            View view = views.getObject().resolveViewName("error/403", request.getLocale());
+            if (view == null) {
+                throw new ServletException("Forbidden view is unavailable");
+            }
+            // Security rejection is always an HTML page, independent of Accept/Content-Type.
+            response.setStatus(HttpServletResponse.SC_FORBIDDEN);
+            response.setContentType("text/html;charset=UTF-8");
+            response.setCharacterEncoding(StandardCharsets.UTF_8.name());
+            view.render(model, request, response);
+        } catch (Exception renderingFailure) {
+            // The normal Boot error dispatch remains the last-resort fallback.
+            // Do not propagate model values or request data through a technical message.
+            throw new ServletException("Unable to render forbidden response");
+        }
+    }
+
+    private boolean valid(HttpServletRequest request) {
+        String expected = tokens.getExisting(request);
+        if (expected == null || queryContainsToken(request.getQueryString())) {
+            return false;
+        }
+        String contentType = request.getContentType();
+        // This step supports ordinary HTML forms; no multipart/upload flow is in scope.
+        if (contentType == null || !contentType.split(";", 2)[0].trim()
+                .equalsIgnoreCase("application/x-www-form-urlencoded")) {
+            return false;
+        }
+        String[] submitted = request.getParameterValues(CsrfTokenService.PARAMETER_NAME);
+        if (submitted == null || submitted.length != 1 || submitted[0] == null
+                || !submitted[0].matches("[0-9a-f]{64}")) {
+            return false;
+        }
+        return MessageDigest.isEqual(expected.getBytes(StandardCharsets.US_ASCII),
+                submitted[0].getBytes(StandardCharsets.US_ASCII));
+    }
+
+    private boolean queryContainsToken(String query) {
+        if (query == null) {
+            return false;
+        }
+        try {
+            for (String part : query.split("&")) {
+                String key = part.split("=", 2)[0];
+                if (CsrfTokenService.PARAMETER_NAME.equals(URLDecoder.decode(key, StandardCharsets.UTF_8))) {
+                    return true;
+                }
+            }
+            return false;
+        } catch (IllegalArgumentException malformed) {
+            return true;
+        }
+    }
+}
diff --git a/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/CsrfTokenService.java b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/CsrfTokenService.java
new file mode 100644
index 0000000..45857c1
--- /dev/null
+++ b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/CsrfTokenService.java
@@ -0,0 +1,43 @@
+package org.csucampuscraft.storefront.foundation.security;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpSession;
+import java.security.SecureRandom;
+import java.util.HexFormat;
+import org.springframework.stereotype.Service;
+
+/** A session token is deliberately separate from login identity and confirmation tokens. */
+@Service
+public final class CsrfTokenService {
+    public static final String PARAMETER_NAME = "_csrf";
+    private static final String SESSION_ATTRIBUTE = CsrfTokenService.class.getName() + ".TOKEN";
+    private final SecureRandom random = new SecureRandom();
+
+    public String getOrCreate(HttpServletRequest request) {
+        HttpSession session = request.getSession(true);
+        synchronized (session) {
+            Object existing = session.getAttribute(SESSION_ATTRIBUTE);
+            if (existing instanceof String token) {
+                return token;
+            }
+            byte[] bytes = new byte[32];
+            random.nextBytes(bytes);
+            String token = HexFormat.of().formatHex(bytes);
+            session.setAttribute(SESSION_ATTRIBUTE, token);
+            return token;
+        }
+    }
+
+    public String getExisting(HttpServletRequest request) {
+        HttpSession session = request.getSession(false);
+        if (session == null) {
+            return null;
+        }
+        try {
+            Object token = session.getAttribute(SESSION_ATTRIBUTE);
+            return token instanceof String text ? text : null;
+        } catch (IllegalStateException expired) {
+            return null;
+        }
+    }
+}
diff --git a/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/PasswordService.java b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/PasswordService.java
new file mode 100644
index 0000000..831575e
--- /dev/null
+++ b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/PasswordService.java
@@ -0,0 +1,26 @@
+package org.csucampuscraft.storefront.foundation.security;
+
+import java.nio.charset.StandardCharsets;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+import org.springframework.stereotype.Service;
+
+/** Raw passwords and hashes must never be placed in a view model or a log. */
+@Service
+public final class PasswordService {
+    private final BCryptPasswordEncoder encoder = new BCryptPasswordEncoder(10);
+
+    public boolean matches(String raw, String hash) {
+        if (raw == null || hash == null || raw.getBytes(StandardCharsets.UTF_8).length > 72
+                || !hash.matches("\\$2[aby]\\$10\\$[./A-Za-z0-9]{53}")) {
+            return false;
+        }
+        return encoder.matches(raw, hash);
+    }
+
+    public String hash(String raw) {
+        if (raw == null || raw.getBytes(StandardCharsets.UTF_8).length > 72) {
+            throw new IllegalArgumentException("Password must fit BCrypt's 72-byte UTF-8 limit");
+        }
+        return encoder.encode(raw);
+    }
+}
diff --git a/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/ReturnUrlPolicy.java b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/ReturnUrlPolicy.java
new file mode 100644
index 0000000..855ad79
--- /dev/null
+++ b/csucampuscraft-user/src/main/java/org/csucampuscraft/storefront/foundation/security/ReturnUrlPolicy.java
@@ -0,0 +1,55 @@
+package org.csucampuscraft.storefront.foundation.security;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Component;
+
+/** Navigation allowlist only: listing a GET destination does not register its controller. */
+@Component
+public final class ReturnUrlPolicy {
+    private static final List<Pattern> READ_PATHS = List.of(
+            Pattern.compile("/"),
+            Pattern.compile("/products(?:/[1-9][0-9]*)?"),
+            Pattern.compile("/cart"),
+            Pattern.compile("/checkout"),
+            Pattern.compile("/orders(?:/[A-Za-z0-9_-]{1,40}(?:/payment)?)?")
+    );
+
+    public String resolve(String returnUrl, String defaultPath) {
+        String fallback = allowed(defaultPath) ? defaultPath : "/";
+        return allowed(returnUrl) ? returnUrl : fallback;
+    }
+
+    private boolean allowed(String value) {
+        if (value == null || value.isEmpty() || !value.equals(value.strip())
+                || value.contains("\\") || value.contains("..") || value.contains("//")
+                || value.chars().anyMatch(c -> c <= 32 || c == 127)) {
+            return false;
+        }
+        try {
+            URI uri = new URI(value);
+            if (uri.isAbsolute() || uri.getRawAuthority() != null || uri.getRawFragment() != null
+                    || !value.startsWith("/") || uri.getRawPath() == null
+                    || uri.getRawPath().contains("%")) {
+                return false;
+            }
+            String query = uri.getRawQuery();
+            if (query != null) {
+                // Inspect one decoded query layer, but preserve the original URL for navigation.
+                String decoded = URLDecoder.decode(query, StandardCharsets.UTF_8);
+                if (decoded.contains("..") || decoded.contains("\\") || decoded.contains("//")
+                        || decoded.chars().anyMatch(c -> c < 32 || c == 127)
+                        || decoded.matches("(?is).*%(?:0[0-9a-f]|1[0-9a-f]|2e|2f|5c|7f|25).*")) {
+                    return false;
+                }
+            }
+            return READ_PATHS.stream().anyMatch(pattern -> pattern.matcher(uri.getPath()).matches());
+        } catch (URISyntaxException | IllegalArgumentException invalid) {
+            return false;
+        }
+    }
+}
