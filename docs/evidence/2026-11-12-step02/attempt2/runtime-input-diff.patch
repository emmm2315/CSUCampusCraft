+<!DOCTYPE html>
+<html lang="zh-CN" xmlns:th="http://www.thymeleaf.org">
+<body>
+<th:block th:fragment="global">
+    <div th:if="${globalMessage != null}" class="alert alert-success" role="status">
+        <p th:text="${globalMessage}">操作已完成。</p>
+    </div>
+    <div th:if="${globalError != null}" class="alert alert-danger" role="alert">
+        <p th:text="${globalError}">请检查操作结果。</p>
+    </div>
