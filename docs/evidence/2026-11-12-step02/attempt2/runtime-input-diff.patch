@@ -0,0 +1,47 @@
+package org.csucampuscraft.admin.foundation.web;
+
+import org.csucampuscraft.admin.foundation.security.CsrfTokenService;
+import org.csucampuscraft.admin.foundation.view.ImagePaths;
+import jakarta.servlet.RequestDispatcher;
+import jakarta.servlet.http.HttpServletRequest;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+/** Shared presentation values only; authentication and cart queries belong to later steps. */
+@ControllerAdvice
+public final class PageModelAdvice {
+    private final CsrfTokenService csrfTokens;
+
+    public PageModelAdvice(CsrfTokenService csrfTokens) { this.csrfTokens = csrfTokens; }
+
+    @ModelAttribute
+    public void contribute(Model model, HttpServletRequest request) {
+        model.addAllAttributes(commonModel(request));
+    }
+
+    /** Also used when MVC resolves a resource error without invoking a controller. */
+    public Map<String, Object> commonModel(HttpServletRequest request) {
+        Map<String, Object> values = new LinkedHashMap<>();
+        values.put("appId", "admin");
+        values.put("siteName", "CSUCampusCraft 管理端");
+        values.put("cartQuantity", 0);
+        values.put("defaultCoverImage", ImagePaths.DEFAULT_COVER);
+        // An invalid write must not create a new session while rendering the rejection.
+        values.put("csrfToken", "GET".equals(request.getMethod())
+                ? csrfTokens.getOrCreate(request) : csrfTokens.getExisting(request));
+        values.put("fieldErrors", Map.of());
+        Object status = request.getAttribute(RequestDispatcher.ERROR_STATUS_CODE);
+        values.put("errorStatus", status instanceof Integer code ? code : 0);
+        values.put("errorCode", publicAttribute(request, "foundation.errorCode"));
+        values.put("errorMessage", publicAttribute(request, "foundation.errorMessage"));
+        return values;
+    }
+
+    private String publicAttribute(HttpServletRequest request, String name) {
+        Object value = request.getAttribute(name);
+        return value instanceof String text ? text : "";
+    }
+}
diff --git a/csucampuscraft-admin/src/main/java/org/csucampuscraft/admin/verification/FoundationVerificationController.java b/csucampuscraft-admin/src/main/java/org/csucampuscraft/admin/verification/FoundationVerificationController.java
new file mode 100644
index 0000000..82b5c25
--- /dev/null
+++ b/csucampuscraft-admin/src/main/java/org/csucampuscraft/admin/verification/FoundationVerificationController.java
@@ -0,0 +1,65 @@
+package org.csucampuscraft.admin.verification;
+import org.csucampuscraft.admin.foundation.web.BusinessException;
+import org.csucampuscraft.admin.foundation.web.HttpResponses;
+import org.csucampuscraft.admin.foundation.validation.InputChecks;
+import org.springframework.context.annotation.Profile;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.*;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Nonpersistent probes for STEP02 acceptance. No production or business routes. */
+@Controller
+@Profile("verification")
+@RequestMapping("/__verification")
+public class FoundationVerificationController {
+    private final AtomicLong acceptedPosts = new AtomicLong();
+
+    @GetMapping("/foundation")
+    public String foundation(@RequestParam(defaultValue = "普通文本") String text, Model model) {
+        model.addAttribute("echoText", text);
+        model.addAttribute("fieldErrors", Map.of("probeText", "请修改此验证字段"));
+        return "verification/foundation";
+    }
+
+    @GetMapping("/errors/{status}")
+    public String error(@PathVariable int status, @RequestParam(defaultValue = "验证请求无法完成") String text) {
+        switch (status) {
+            case 400, 403, 404, 409 -> throw new BusinessException(HttpStatus.valueOf(status),
+                    "VERIFICATION_" + status, text);
+            case 500 -> throw new IllegalStateException("VERIFICATION_SQL_PASSWORD_STACK_SENTINEL");
+            default -> throw new BusinessException(HttpStatus.BAD_REQUEST, "VERIFICATION_STATUS",
+                    "验证状态无效");
+        }
+    }
+
+    @PostMapping("/submit")
+    public ResponseEntity<Void> submit() {
+        acceptedPosts.incrementAndGet();
+        return HttpResponses.seeOther("/");
+    }
+
+    @GetMapping("/counter")
+    @ResponseBody
+    public Map<String, Long> counter() {
+        return Map.of("acceptedPosts", acceptedPosts.get());
+    }
+
+    @GetMapping("/validation")
+    @ResponseBody
+    public Map<String, Object> validation(@RequestParam String kind, @RequestParam String value) {
+        Object checked = switch (kind) {
+            case "integer" -> InputChecks.integer("probeNumber", value, 0, 99);
+            case "money" -> InputChecks.money("probeAmount", value);
+            case "length" -> InputChecks.requiredText("probeText", value, 4);
+            case "enum" -> InputChecks.enumeration("probeState", value, ProbeState.class);
+            default -> throw new BusinessException(HttpStatus.BAD_REQUEST, "VERIFICATION_KIND",
+                    "验证类型无效");
+        };
+        return Map.of("checked", checked.toString());
+    }
+    public enum ProbeState { FIRST, SECOND }
+}
