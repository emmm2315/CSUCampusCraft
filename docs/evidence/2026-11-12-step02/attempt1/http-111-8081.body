:root {
    --color-bg: #F5F8F4;
    --color-surface: #FFFFFF;
    --color-text: #1C312A;
    --color-muted: #52655D;
    --color-primary: #225B46;
    --color-on-primary: #FFFFFF;
    --color-border: #D3DFD2;
    --color-focus: #1468AD;
    --color-success: #226644;
    --color-warning: #785300;
    --color-danger: #9F2929;
    --font-family: system-ui, "Microsoft YaHei", "PingFang SC", sans-serif;
    --font-size: 16px;
    --font-size-small: 14px;
    --font-size-title: 28px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;
    --radius: 8px;
}
* { box-sizing: border-box; }
html { color-scheme: light; }
body {
    margin: 0;
    color: var(--color-text);
    background: var(--color-bg);
    font: var(--font-size)/1.6 var(--font-family);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}
a { color: var(--color-primary); text-underline-offset: 3px; }
a:hover { text-decoration-thickness: 2px; }
:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
h1, h2, h3, p { margin: 0; }
h1 { font-size: var(--font-size-title); line-height: 1.35; font-weight: 700; }
h2 { font-size: 20px; line-height: 1.4; }
h3 { font-size: 18px; line-height: 1.4; }
p + p { margin-top: var(--space-3); }
small, .small { font-size: var(--font-size-small); }
.muted { color: var(--color-muted); }
.container { width: min(100% - 48px, 1120px); margin-inline: auto; }
.main-content { flex: 1; padding-block: var(--space-8); }
.site-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
.site-header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); min-height: 80px; padding-block: var(--space-4); }
.site-brand { display: inline-flex; align-items: center; gap: var(--space-3); font-weight: 700; color: var(--color-text); text-decoration: none; }
.brand-mark { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius); background: var(--color-primary); color: var(--color-on-primary); font-size: 14px; letter-spacing: 1px; }
.site-nav { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-6); }
.site-nav > a { padding-block: var(--space-2); }
.app-label { color: var(--color-muted); font-size: var(--font-size-small); }
.nav-placeholder { display: inline-flex; align-items: center; gap: var(--space-2); }
.quantity-badge { display: inline-grid; place-items: center; min-width: 24px; min-height: 24px; padding-inline: var(--space-2); color: var(--color-primary); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 999px; font-size: var(--font-size-small); }
.global-alerts:has(.alert) { padding-top: var(--space-6); }
.page-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-6); }
.eyebrow { color: var(--color-primary); font-size: var(--font-size-small); font-weight: 600; }
.panel { padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); }
.panel > h2 { margin-bottom: var(--space-3); }
.theme-list { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-3); padding: 0; margin: var(--space-6) 0 0; }
.theme-list > li { padding: var(--space-4); border: 1px solid var(--color-border); background: var(--color-bg); border-radius: var(--radius); overflow-wrap: anywhere; }
.empty-state { padding: var(--space-6); color: var(--color-muted); border: 1px dashed var(--color-border); border-radius: var(--radius); margin-top: var(--space-4); }
.site-footer { border-top: 1px solid var(--color-border); padding-block: var(--space-6); font-size: var(--font-size-small); }
.site-footer > .container { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); }
.skip-link { position: fixed; left: var(--space-4); top: var(--space-4); z-index: 20; transform: translateY(-200%); padding: var(--space-3) var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); }
.skip-link:focus { transform: translateY(0); }
.button, button, input[type="submit"] {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: 44px; padding: var(--space-2) var(--space-4); border: 1px solid var(--color-primary);
    border-radius: var(--radius); background: var(--color-primary); color: var(--color-on-primary);
    font: inherit; font-weight: 600; text-decoration: none; cursor: pointer;
}
.button:hover, button:hover, input[type="submit"]:hover { filter: brightness(.93); }
.button-secondary { background: var(--color-surface); color: var(--color-primary); }
.button-danger { background: var(--color-danger); border-color: var(--color-danger); color: var(--color-on-primary); }
button:disabled, input[type="submit"]:disabled, .button[aria-disabled="true"] { opacity: .55; cursor: not-allowed; filter: none; }
form.is-submitting [type="submit"], [aria-busy="true"] [type="submit"] { opacity: .65; cursor: progress; filter: none; }
.button-row { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
.form-field { display: grid; align-content: start; gap: var(--space-2); min-width: 0; margin-bottom: var(--space-4); }
label { font-weight: 600; }
input:not([type="hidden"]):not([type="submit"]):not([type="checkbox"]):not([type="radio"]), select, textarea {
    width: 100%; min-height: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border);
    border-radius: var(--radius); color: var(--color-text); background: var(--color-surface); font: inherit;
}
textarea { min-height: 120px; resize: vertical; }
input:disabled, select:disabled, textarea:disabled { opacity: .65; cursor: not-allowed; background: var(--color-bg); }
input[readonly], textarea[readonly] { background: var(--color-bg); }
input.input-error, select.input-error, textarea.input-error, [aria-invalid="true"] { border-color: var(--color-danger); }
.field-error { color: var(--color-danger); font-size: var(--font-size-small); }
.field-help { color: var(--color-muted); font-size: var(--font-size-small); }
.alert { padding: var(--space-4); border: 1px solid currentColor; border-radius: var(--radius); background: var(--color-surface); margin-bottom: var(--space-4); }
.alert p { overflow-wrap: anywhere; }
.alert-success { color: var(--color-success); }
.alert-warning { color: var(--color-warning); }
.alert-danger { color: var(--color-danger); }
.alert[aria-busy="true"], .alert.is-loading { opacity: .75; cursor: progress; }
.error-summary h2 { font-size: 18px; }
.error-summary ul { padding-left: var(--space-6); margin-block: var(--space-2) 0; }
.error-summary a { color: inherit; }
.error-page { max-width: 760px; margin-inline: auto; }
.error-number { font-size: 40px; font-weight: 700; color: var(--color-muted); }
.error-page h1 { margin-block: var(--space-2) var(--space-4); }
.error-page .error-code { margin-top: var(--space-4); color: var(--color-muted); font-size: var(--font-size-small); overflow-wrap: anywhere; }
.error-page .error-summary { margin-top: var(--space-6); }
.table-container { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); }
table { width: 100%; border-collapse: collapse; text-align: left; }
caption { padding: var(--space-4); text-align: left; font-weight: 600; }
th, td { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); vertical-align: top; }
th { font-weight: 600; background: var(--color-bg); }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: var(--color-bg); }
tbody tr[aria-disabled="true"] { color: var(--color-muted); background: var(--color-bg); }
.table-container[aria-busy="true"] { opacity: .7; cursor: progress; }
.catalog-image { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius); }
@media (max-width: 900px) {
    .theme-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 600px) {
    .container { width: calc(100% - 32px); }
    .site-header-inner { align-items: flex-start; flex-direction: column; gap: var(--space-3); }
    .site-nav { width: 100%; gap: var(--space-4); }
    .main-content { padding-block: var(--space-6); }
    .panel { padding: var(--space-4); }
    .theme-list, .form-grid { grid-template-columns: 1fr; }
    .button-row { align-items: stretch; }
    .button-row > .button { flex: 1; }
}
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; }
}
