+[data-page-id="U06"] .checkout-product-image .catalog-image { width: 48px; }
+[data-page-id="U06"] .checkout-sku { margin-top: var(--space-2); overflow-wrap: anywhere; }
+[data-page-id="U06"] .checkout-money { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+[data-page-id="U06"] .checkout-total-panel { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
+[data-page-id="U06"] .checkout-total-panel h2 { margin-bottom: var(--space-2); }
+[data-page-id="U06"] .checkout-total { font-size: 28px; }
+[data-page-id="U06"] .checkout-confirmation-help { margin-top: var(--space-4); overflow-wrap: anywhere; }
+[data-page-id="U06"] .checkout-shipping > .field-help { margin-bottom: var(--space-6); }
+[data-page-id="U06"] .checkout-shipping .button-row > button { width: 100%; }
+[data-page-id="U06"] .checkout-shipping .form-field input { min-width: 0; }
+@media (max-width: 960px) {
+    [data-page-id="U06"] .checkout-grid { grid-template-columns: 1fr; }
+}
+@media (max-width: 600px) {
+    [data-page-id="U06"] .checkout-heading > .button { width: 100%; }
+    [data-page-id="U06"] .checkout-total-panel { align-items: start; flex-direction: column; }
+}
