+[data-page-id="A10"] .album-gallery { margin-top: var(--space-6); }
+[data-page-id="A10"] .album-section-heading { margin-bottom: var(--space-4); }
+[data-page-id="A10"] .album-fields {
+    display: grid; grid-template-columns: minmax(0, 2fr) minmax(140px, 1fr);
+    gap: var(--space-4); margin-top: var(--space-4);
+}
+[data-page-id="A10"] .album-path-field { grid-column: 1 / -1; }
+[data-page-id="A10"] .album-fields .form-field { margin-bottom: 0; }
+[data-page-id="A10"] .album-fields .field-help { margin-top: var(--space-2); }
+[data-page-id="A10"] .album-records { display: grid; gap: var(--space-4); }
+[data-page-id="A10"] .album-record {
+    display: grid; grid-template-columns: 192px minmax(0, 1fr);
+    align-items: start; gap: var(--space-6);
+}
+[data-page-id="A10"] .album-record-content { min-width: 0; }
+[data-page-id="A10"] .album-preview .field-help { margin-top: var(--space-2); }
+[data-page-id="A10"] .album-remove {
+    display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3);
+    padding-top: var(--space-4); margin-top: var(--space-4);
+    border-top: 1px solid var(--color-border);
+}
+@media (max-width: 760px) {
+    [data-page-id="A10"] .album-product,
+    [data-page-id="A10"] .album-record { grid-template-columns: 1fr; }
+    [data-page-id="A10"] .album-cover { max-width: 160px; }
+    [data-page-id="A10"] .album-preview { max-width: 240px; }
+    [data-page-id="A10"] .album-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    [data-page-id="A10"] .album-fields { grid-template-columns: 1fr; }
+}
