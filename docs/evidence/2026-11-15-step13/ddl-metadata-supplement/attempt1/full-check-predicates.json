    },
    {
      "name": "ck_order_item_quantity",
      "table": "sales_order_item",
      "enforced": "YES",
      "predicate": "(`quantity` between 1 and 99)"
    },
    {
      "name": "ck_order_item_sku",
      "table": "sales_order_item",
