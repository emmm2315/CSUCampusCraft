    {
      "name": "ck_order_cancel_time",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(((`status` = _utf8mb4\\'CANCELLED\\') and (`cancelled_at` is not null)) or ((`status` <> _utf8mb4\\'CANCELLED\\') and (`cancelled_at` is null)))"
    },
    {
      "name": "ck_order_complete_time",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(((`status` = _utf8mb4\\'COMPLETED\\') and (`completed_at` is not null)) or ((`status` <> _utf8mb4\\'COMPLETED\\') and (`completed_at` is null)))"
    },
    {
      "name": "ck_order_no",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(char_length(trim(`order_no`)) > 0)"
    },
    {
      "name": "ck_order_payment_info",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(((`status` in (_utf8mb4\\'PENDING_PAYMENT\\',_utf8mb4\\'CANCELLED\\')) and (`payment_method` is null) and (`payment_no` is null) and (`paid_at` is null)) or ((`status` in (_utf8mb4\\'PAID\\',_utf8mb4\\'SHIPPED\\',_utf8mb4\\'COMPLETED\\')) and (`payment_method` is not null) and (`payment_method` = _utf8mb4\\'MOCK\\') and (`payment_no` is not null) and (char_length(trim(`payment_no`)) > 0) and (`paid_at` is not null)))"
    },
    {
      "name": "ck_order_receiver",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "((char_length(trim(`receiver_name`)) > 0) and (char_length(trim(`receiver_phone`)) > 0) and (char_length(trim(`receiver_address`)) > 0))"
    },
    {
      "name": "ck_order_ship_time",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(((`status` in (_utf8mb4\\'SHIPPED\\',_utf8mb4\\'COMPLETED\\')) and (`shipped_at` is not null)) or ((`status` not in (_utf8mb4\\'SHIPPED\\',_utf8mb4\\'COMPLETED\\')) and (`shipped_at` is null)))"
    },
    {
      "name": "ck_order_status",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(`status` in (_utf8mb4\\'PENDING_PAYMENT\\',_utf8mb4\\'PAID\\',_utf8mb4\\'SHIPPED\\',_utf8mb4\\'COMPLETED\\',_utf8mb4\\'CANCELLED\\'))"
    },
    {
      "name": "ck_order_time_sequence",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(((`paid_at` is null) or (`paid_at` >= `created_at`)) and ((`cancelled_at` is null) or (`cancelled_at` >= `created_at`)) and ((`shipped_at` is null) or (`shipped_at` >= `paid_at`)) and ((`completed_at` is null) or (`completed_at` >= `shipped_at`)))"
    },
    {
      "name": "ck_order_total",
      "table": "sales_order",
      "enforced": "YES",
      "predicate": "(`total_amount` > 0)"
    },
    {
      "name": "ck_order_item_amount",
      "table": "sales_order_item",
      "enforced": "YES",
      "predicate": "((`line_amount` > 0) and (`line_amount` = (`unit_price` * `quantity`)))"
    },
    {
