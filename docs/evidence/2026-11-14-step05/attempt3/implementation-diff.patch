diff --git a/csucampuscraft-admin/src/main/resources/templates/products/form.html b/csucampuscraft-admin/src/main/resources/templates/products/form.html
new file mode 100644
index 0000000..a109b58
--- /dev/null
+++ b/csucampuscraft-admin/src/main/resources/templates/products/form.html
@@ -0,0 +1,110 @@
+<!DOCTYPE html>
+<html lang="zh-CN" xmlns:th="http://www.thymeleaf.org"
+      th:replace="~{fragments/layout :: page(${editing ? '编辑商品 · CSUCampusCraft' : '新建商品 · CSUCampusCraft'}, ~{::mainContent})}">
+<head><title>商品资料</title></head>
+<body>
+<div th:fragment="mainContent" data-page-id="A05"
+     th:attr="data-product-id=${product == null ? null : product.id},data-version=${product == null ? 0 : product.version}">
+    <header class="page-heading admin-toolbar">
+        <div><p class="eyebrow">商品资料</p><h1 th:text="${editing ? '编辑商品' : '新建商品'}">商品资料</h1>
+            <p class="muted" th:text="${editing ? '修改资料时保留现有 SKU、库存和上架状态。' : '新商品先保存为草稿，检查后再上架。'}">商品说明</p></div>
+        <div class="button-row">
+            <a class="button button-secondary" th:href="${returnUrl}">返回商品列表</a>
+            <a class="button button-secondary" th:if="${editing}"
+               th:href="@{/products/{id}/edit(id=${product.id},returnUrl=${returnUrl})}" data-reload-product>重新载入编辑页</a>
+        </div>
+    </header>
+    <div class="empty-state" th:if="${#lists.isEmpty(categories)}">
+        <p>还没有可用的二级分类，请先创建分类。</p><a th:href="@{/categories/new}">前往分类管理</a>
+    </div>
+    <th:block th:replace="~{fragments/alerts :: summary(${fieldErrors})}"></th:block>
+    <section class="panel">
+        <form method="post" th:action="${editing ? '/products/' + product.id : '/products'}" data-submit-state data-product-form>
+            <th:block th:replace="~{fragments/fields :: csrf}"></th:block>
+            <input type="hidden" name="returnUrl" th:value="${returnUrl}">
+            <input th:if="${editing}" type="hidden" name="version" th:value="${form.version}">
+            <p id="version" class="field-help" th:if="${editing}" th:classappend="${fieldErrors.containsKey('version') ? 'field-error' : ''}"
+               th:text="${fieldErrors.containsKey('version') ? fieldErrors.get('version') : '保存时核对商品资料状态；提示过期时请重新载入。'}">资料状态</p>
+            <div class="form-grid">
+                <th:block th:if="${!editing}"><th:block th:replace="~{fragments/fields :: text('sku','sku','SKU',${form.sku},${fieldErrors})}"></th:block></th:block>
+                <div class="form-field" th:if="${editing}">
+                    <label for="sku">SKU（只读）</label>
+                    <input id="sku" type="text" readonly th:value="${product.sku}">
+                </div>
+                <div class="form-field" th:with="hasError=${fieldErrors.containsKey('categoryId')}">
+                    <label for="categoryId">二级分类</label>
+                    <select id="categoryId" name="categoryId"
+                            th:attr="aria-invalid=${hasError},aria-describedby=${hasError ? 'categoryId-error' : null}">
+                        <option value="">请选择二级分类</option>
+                        <option th:each="choice : ${categories}" th:value="${choice.id}"
+                                th:selected="${form.categoryId != null and form.categoryId.strip() == choice.id.toString()}"
+                                th:text="${choice.label}">二级分类</option>
+                    </select>
+                    <p class="field-error" id="categoryId-error" th:if="${hasError}" th:text="${fieldErrors.get('categoryId')}">请选择分类。</p>
+                </div>
+                <th:block th:replace="~{fragments/fields :: text('name','name','商品名称',${form.name},${fieldErrors})}"></th:block>
+                <th:block th:replace="~{fragments/fields :: text('price','price','售价（元）',${form.price},${fieldErrors})}"></th:block>
+                <th:block th:if="${!editing}"><th:block th:replace="~{fragments/fields :: number('stock','stock','初始库存',${form.stock},0,2147483647,1,${fieldErrors})}"></th:block></th:block>
+                <div class="form-field" th:if="${editing}">
+                    <label for="stock">当前库存（只读）</label>
+                    <input id="stock" type="number" readonly th:value="${product.stock}">
+                </div>
+                <th:block th:replace="~{fragments/fields :: number('sortOrder','sortOrder','排序值',${form.sortOrder},0,2147483647,1,${fieldErrors})}"></th:block>
+            </div>
+            <p class="field-help">SKU 最多 40 个字符，名称最多 120 个字符。售价为 0.01–9,999,999,999.99 元，最多两位小数。</p>
+            <div class="form-field" th:with="hasError=${fieldErrors.containsKey('summary')}">
+                <label for="summary">商品摘要</label>
+                <textarea id="summary" name="summary" rows="3" th:text="${form.summary}"
+                          th:attr="aria-invalid=${hasError},aria-describedby=${hasError ? 'summary-error' : 'summary-help'}"></textarea>
+                <p id="summary-help" class="field-help">可选，最多 500 个字符。</p>
+                <p id="summary-error" class="field-error" th:if="${hasError}" th:text="${fieldErrors.get('summary')}">摘要过长。</p>
+            </div>
+            <div class="form-field" th:with="hasError=${fieldErrors.containsKey('description')}">
+                <label for="description">设计说明</label>
+                <textarea id="description" name="description" rows="6" th:text="${form.description}"
+                          th:attr="aria-invalid=${hasError},aria-describedby=${hasError ? 'description-error' : 'description-help'}"></textarea>
+                <p id="description-help" class="field-help">可选，按普通文本保存；内容总量最多 65,535 字节。</p>
+                <p id="description-error" class="field-error" th:if="${hasError}" th:text="${fieldErrors.get('description')}">设计说明过长。</p>
+            </div>
+            <th:block th:replace="~{fragments/fields :: text('coverImage','coverImage','封面路径',${form.coverImage},${fieldErrors})}"></th:block>
+            <p class="field-help">可留空。填写时使用 images/ 下的站内相对路径，最多 255 个字符。</p>
+            <div class="button-row">
+                <button type="submit" th:disabled="${#lists.isEmpty(categories)}" th:text="${editing ? '保存资料' : '保存草稿'}">保存</button>
+                <a class="button button-secondary" th:href="${returnUrl}">取消</a>
+            </div>
+        </form>
+    </section>
+    <section class="panel" th:if="${editing}" aria-labelledby="status-heading">
+        <h2 id="status-heading">商品状态</h2>
+        <p>当前为 <strong th:text="${product.status == 'DRAFT' ? '草稿' : '上架'}">草稿</strong>
+            <span th:if="${product.status == 'ON_SALE' and product.stock == 0}">（售罄）</span></p>
+        <div class="button-row">
+            <form th:if="${product.status == 'DRAFT'}" method="post" th:action="@{/products/{id}/publish(id=${product.id})}"
+                  data-submit-state data-product-action="publish">
+                <th:block th:replace="~{fragments/fields :: csrf}"></th:block>
+                <input type="hidden" name="returnUrl" th:value="${returnUrl}">
+                <input type="hidden" name="version" th:value="${product.version}">
+                <button type="submit">上架商品</button>
+            </form>
+            <form th:if="${product.status == 'ON_SALE'}" method="post" th:action="@{/products/{id}/unpublish(id=${product.id})}"
+                  data-submit-state data-product-action="unpublish">
+                <th:block th:replace="~{fragments/fields :: csrf}"></th:block>
+                <input type="hidden" name="returnUrl" th:value="${returnUrl}">
+                <input type="hidden" name="version" th:value="${product.version}">
+                <button type="submit" class="button-secondary">下架商品</button>
+            </form>
+        </div>
+    </section>
+    <section class="panel" th:if="${editing}" aria-labelledby="restock-heading">
+        <h2 id="restock-heading">增量补货</h2>
+        <p>当前库存 <strong th:text="${product.stock}">0</strong> 件。提交一次表示增加一次指定数量。</p>
+        <form method="post" th:action="@{/products/{id}/restock(id=${product.id})}" data-submit-state data-restock-form>
+            <th:block th:replace="~{fragments/fields :: csrf}"></th:block>
+            <input type="hidden" name="returnUrl" th:value="${returnUrl}">
+            <th:block th:replace="~{fragments/fields :: number('quantity','quantity','本次增加数量',${restockQuantity},1,2147483647,1,${fieldErrors})}"></th:block>
+            <button type="submit">确认补货</button>
+        </form>
+    </section>
+</div>
+</body>
+</html>
diff --git a/csucampuscraft-admin/src/main/resources/templates/products/list.html b/csucampuscraft-admin/src/main/resources/templates/products/list.html
new file mode 100644
index 0000000..87cd9b2
--- /dev/null
+++ b/csucampuscraft-admin/src/main/resources/templates/products/list.html
@@ -0,0 +1,104 @@
+<!DOCTYPE html>
+<html lang="zh-CN" xmlns:th="http://www.thymeleaf.org"
+      th:replace="~{fragments/layout :: page('商品管理 · CSUCampusCraft', ~{::mainContent})}">
+<head><title>商品管理</title></head>
+<body>
+<div th:fragment="mainContent" data-page-id="A04"
+     th:attr="data-product-count=${total},data-result-count=${#lists.size(products)},data-page=${page},data-size=${size}">
+    <header class="page-heading admin-toolbar">
+        <div><p class="eyebrow">商品维护</p><h1>商品管理</h1><p class="muted">按主题或二级分类查找草稿与上架商品。</p></div>
+        <div class="button-row">
+            <a class="button" th:href="@{/products/new(returnUrl=${returnUrl})}">新建商品</a>
+            <a class="button button-secondary" th:href="@{/categories}">分类管理</a>
+        </div>
+    </header>
+    <section class="panel" aria-labelledby="filter-heading">
+        <h2 id="filter-heading">筛选商品</h2>
+        <form method="get" th:action="@{/products}" class="admin-filter-form">
+            <div class="form-grid">
+                <div class="form-field">
+                    <label for="categoryId">主题或分类</label>
+                    <select name="categoryId" id="categoryId">
+                        <option value="" th:selected="${query.categoryId == null}">全部分类</option>
+                        <option th:each="choice : ${categories}" th:value="${choice.id}"
+                                th:selected="${query.categoryId != null and query.categoryId == choice.id}"
+                                th:text="${choice.label}">分类</option>
+                    </select>
+                </div>
+                <div class="form-field">
+                    <label for="q">商品名称</label>
+                    <input type="search" id="q" name="q" th:value="${query.q}" aria-describedby="q-help">
+                    <p id="q-help" class="field-help">名称包含查询，最多 120 个字符。</p>
+                </div>
+                <div class="form-field">
+                    <label for="status">商品状态</label>
+                    <select name="status" id="status">
+                        <option value="ALL" th:selected="${query.status.name() == 'ALL'}">全部</option>
+                        <option value="DRAFT" th:selected="${query.status.name() == 'DRAFT'}">草稿</option>
+                        <option value="ON_SALE" th:selected="${query.status.name() == 'ON_SALE'}">上架</option>
+                    </select>
+                </div>
+                <div class="form-field">
+                    <label for="size">每页条数</label>
+                    <input type="number" id="size" name="size" min="1" max="50" step="1" th:value="${size}">
+                </div>
+            </div>
+            <input type="hidden" name="page" value="1">
+            <button type="submit">查询</button>
+            <a class="button button-secondary" th:href="@{/products}">清除筛选</a>
+        </form>
+    </section>
+    <p class="field-help">共 <strong th:text="${total}">0</strong> 件商品，默认按排序值和商品编号升序展示。</p>
+    <div class="empty-state" th:if="${#lists.isEmpty(products)}" data-product-empty>
+        <p th:text="${total > 0 ? '当前页没有商品，请返回有效页面。' : '暂无符合条件的商品，可调整筛选或新建草稿。'}">暂无商品。</p>
+        <a th:href="${query.path(1)}" data-page-link="1">返回第 1 页</a>
+    </div>
+    <div class="table-container" th:unless="${#lists.isEmpty(products)}">
+        <table>
+            <caption>商品列表</caption>
+            <thead><tr><th scope="col">商品 / SKU</th><th scope="col">分类</th><th scope="col">售价</th><th scope="col">库存</th><th scope="col">状态</th><th scope="col">排序</th><th scope="col">操作</th></tr></thead>
+            <tbody>
+            <tr th:each="item : ${products}"
+                th:attr="data-product-id=${item.id},data-sku=${item.sku},data-stock=${item.stock},data-version=${item.version},data-status=${item.status}">
+                <td><strong th:text="${item.name}">商品</strong><p class="field-help" th:text="${item.sku}">SKU</p></td>
+                <td th:text="${item.categoryName}">分类</td>
+                <td th:text="${'¥' + #numbers.formatDecimal(item.price,1,'NONE',2,'POINT')}">¥0.00</td>
+                <td th:text="${item.stock}">0</td>
+                <td><span th:text="${item.status == 'DRAFT' ? '草稿' : '上架'}">草稿</span>
+                    <p class="field-help" th:if="${item.status == 'ON_SALE' and item.stock == 0}">售罄</p></td>
+                <td th:text="${item.sortOrder}">0</td>
+                <td>
+                    <div class="admin-row-actions">
+                        <a class="button button-secondary" th:href="@{/products/{id}/edit(id=${item.id},returnUrl=${returnUrl})}">编辑</a>
+                        <form th:if="${item.status == 'DRAFT'}" method="post"
+                              th:action="@{/products/{id}/publish(id=${item.id})}" data-submit-state data-product-action="publish">
+                            <th:block th:replace="~{fragments/fields :: csrf}"></th:block>
+                            <input type="hidden" name="version" th:value="${item.version}">
+                            <input type="hidden" name="returnUrl" th:value="${returnUrl}">
+                            <button type="submit">上架</button>
+                        </form>
+                        <form th:if="${item.status == 'ON_SALE'}" method="post"
+                              th:action="@{/products/{id}/unpublish(id=${item.id})}" data-submit-state data-product-action="unpublish">
+                            <th:block th:replace="~{fragments/fields :: csrf}"></th:block>
+                            <input type="hidden" name="version" th:value="${item.version}">
+                            <input type="hidden" name="returnUrl" th:value="${returnUrl}">
+                            <button type="submit" class="button-secondary">下架</button>
+                        </form>
+                    </div>
+                    <!-- STEP06 接入相册维护；本步不注册相册路由。 -->
+                    <p class="field-help">相册管理暂未开放</p>
+                </td>
+            </tr>
+            </tbody>
+        </table>
+    </div>
+    <nav class="admin-pagination button-row" aria-label="商品分页" th:if="${total > 0}">
+        <a class="button button-secondary" th:if="${hasPrevious}" th:href="${query.path(previousPage)}" th:attr="data-page-link=${previousPage}">上一页</a>
+        <span th:unless="${hasPrevious}" aria-disabled="true">上一页</span>
+        <span>第 <strong th:text="${page}">1</strong> 页 / 共 <span th:text="${totalPages}">1</span> 页</span>
+        <a class="button button-secondary" th:if="${hasNext}" th:href="${query.path(nextPage)}" th:attr="data-page-link=${nextPage}">下一页</a>
+        <span th:unless="${hasNext}" aria-disabled="true">下一页</span>
+    </nav>
+</div>
+</body>
+</html>
