    write(cl,'/products/'+str(pid)+'/publish',{'version':str(p['version'])},303,'publish-new-product',back='/products/'+str(pid)+'/edit')
    r=public_detail(pid,200,'published-visible');check('description-plain-text','<script>notExecutable' not in r[2].decode() and '&lt;script&gt;' in r[2].decode())
    p=product(pid);write(cl,'/products/'+str(pid)+'/publish',{'version':str(p['version'])},409,'repeat-publish-state',back='/products/'+str(pid)+'/edit')
    old_version=p['version'];write(cl,'/products/'+str(pid)+'/restock',{'quantity':'3','stock':'999999'},303,'incremental-restock',back='/products/'+str(pid)+'/edit')
    p=product(pid);check('restock-current-plus3',p['stock']==13 and p['version']==old_version+1);public_detail(pid,200,'restock-user-visible')
    write(cl,'/products/'+str(pid),dict(edit,version=str(old_version)),409,'old-form-after-restock',back='/products/'+str(pid)+'/edit')
    write(cl,'/products/'+str(pid)+'/restock',{'quantity':'2'},303,'second-independent-restock',back='/products/'+str(pid)+'/edit')
    check('second-restock-is-new-increment',product(pid)['stock']==15)
    for qty in ['','0','-1','1.5','2147483648']:
        write(cl,'/products/'+str(pid)+'/restock',{'quantity':qty},400,'invalid-restock-'+qty,back='/products/'+str(pid)+'/edit')
    # Preserve successful filter context, including literal LIKE punctuation.
    ret='/products?'+urllib.parse.urlencode({'categoryId':root,'q':'%_\\','status':'ALL','page':2,'size':3})
    r,_,_=write(cl,'/products/'+str(pid)+'/restock',{'quantity':'1','returnUrl':ret},303,'restock-return-filter',back='/products/'+str(pid)+'/edit')
    check('return-all-filter-values',urllib.parse.parse_qs(urllib.parse.urlsplit(r[1]['Location']).query)==urllib.parse.parse_qs(urllib.parse.urlsplit(ret).query))
    r,_,_=write(cl,'/products/'+str(pid)+'/restock',{'quantity':'1','returnUrl':'https://external.invalid/'},303,'external-return-fallback',back='/products/'+str(pid)+'/edit')
    check('external-return-safe',urllib.parse.urlsplit(r[1]['Location']).path=='/products')
    write(cl,'/products/'+str(pid)+'/unpublish',{'version':str(product(pid)['version'])},303,'unpublish-new-product',back='/products/'+str(pid)+'/edit');public_detail(pid,404,'unpublished-detail-404')
    gift=int(rows("SELECT id FROM product WHERE sku='CSU-GRAD-BOX-01'"))
    gift_before=product(gift);write(cl,'/products/'+str(gift)+'/unpublish',{'version':str(gift_before['version'])},303,'gift-unpublish',back='/products/'+str(gift)+'/edit');public_detail(gift,404,'gift-hidden')
    write(cl,'/products/'+str(gift)+'/publish',{'version':str(product(gift)['version'])},303,'gift-republish',back='/products/'+str(gift)+'/edit');public_detail(gift,200,'gift-visible-again')
    for params in [{},{'categoryId':root},{'categoryId':child,'status':'DRAFT'},{'q':'STEP05','size':2,'page':2},{'status':'ON_SALE','size':50},{'page':999,'size':3},{'page':0}]:
        verify_list(cl,params,'admin-query-'+str(len(result['checks'])))
    sold=verify_list(cl,{'status':'ON_SALE','size':50},'sold-out-admin-list')
    sold_row=sold[3].find(lambda n:n.a.get('data-product-id')=='47')
    check('sold-out-admin-label',sold_row is not None and '售罄' in sold_row.text())
    public_detail(47,200,'sold-out-still-public')
    for params in [{'status':'BAD'},{'page':'x'},{'size':0},{'size':51},{'categoryId':'x'}]:
        assert_page(cl.get('/products?'+urllib.parse.urlencode(params),8081),400,'query-invalid-'+str(len(result['checks'])))
    assert_page(cl.get('/products?'+urllib.parse.urlencode({'q':'x'*121}),8081),400,'query-keyword-121-rejected')
    # Dedicated draft matches wildcards literally; it is a genuine application create.
    literalform=product_form(sku='CSU-QA-LITERAL',categoryId=str(child),name='STEP05 100% under_score back\\slash bang!')
    write(cl,'/products',literalform,303,'create-literal-product',back='/products/new')
    for q in ['%','_','\\','!']:verify_list(cl,{'q':q},'literal-like-'+str(ord(q)))
    overflow_id=pid_by_sku('CSU-QA-MIN');old=product(overflow_id)
    fixture_product(overflow_id,'stock=2147483647,updated_at=updated_at','max-int-stock')
    write(cl,'/products/'+str(overflow_id)+'/restock',{'quantity':'1'},409,'stock-overflow',back='/products/'+str(overflow_id)+'/edit')
    fixture_product(overflow_id,'stock='+str(old['stock'])+',version=9223372036854775807,updated_at=updated_at','max-long-version')
    write(cl,'/products/'+str(overflow_id)+'/restock',{'quantity':'1'},409,'version-overflow',back='/products/'+str(overflow_id)+'/edit')
    fixture_product(overflow_id,'version='+str(old['version'])+',updated_at=updated_at','restore-overflow-fixture')
    actor_probe()
    write(cl,'/products/'+str(pid)+'/publish',{'version':str(product(pid)['version'])},303,'republish-for-browser-read',back='/products/'+str(pid)+'/edit')
    # 14 key states at two viewport widths, no repeated screenshot per request.
    cases=[
      {'name':'categories','port':8081,'path':'/categories','kind':'A03'},
      {'name':'new-category','port':8081,'path':'/categories/new','kind':'A03'},
      {'name':'category-code-400','port':8081,'path':'/categories/new','kind':'A03','submit':{'kind':'category','status':400,'fields':{'code':'Q'*22,'name':'非法22字符编码','sortOrder':'0'}}},
      {'name':'category-duplicate-409','port':8081,'path':'/categories/new','kind':'A03','submit':{'kind':'category','status':409,'fields':{'code':'STEP05_QA','name':'重复编码反馈','sortOrder':'0'}}},
      {'name':'products','port':8081,'path':'/products','kind':'A04'},
      {'name':'literal-filter','port':8081,'path':'/products?q=%25','kind':'A04'},
      {'name':'new-product','port':8081,'path':'/products/new','kind':'A05'},
      {'name':'product-price-400','port':8081,'path':'/products/new','kind':'A05','submit':{'kind':'product','status':400,'fields':{'sku':'CSU-QA-BROWSER-INVALID','categoryId':str(child),'name':'非法价格反馈','price':'0.001','stock':'0','sortOrder':'0'}}},
      {'name':'product-sku-409','port':8081,'path':'/products/new','kind':'A05','submit':{'kind':'product','status':409,'fields':{'sku':base['sku'],'categoryId':str(child),'name':'重复SKU反馈','price':'12.50','stock':'0','sortOrder':'0'}}},
      {'name':'edit-product','port':8081,'path':'/products/'+str(pid)+'/edit','kind':'A05'},
      {'name':'product-old-version-409','port':8081,'path':'/products/'+str(pid)+'/edit','kind':'A05','submit':{'kind':'product','status':409,'fields':{},'stale':True}},
      {'name':'user-new-theme','port':8080,'path':'/','kind':'U01'},
      {'name':'user-gift-detail','port':8080,'path':'/products/'+str(gift),'kind':'U03'},
      {'name':'user-new-detail','port':8080,'path':'/products/'+str(pid),'kind':'U03'}]
    browser(cl.cookie(8081),cases)
    final=snapshot();save(EV/'database-final.json',json.dumps(final,indent=2));check('final-five-noncatalog-tables-unchanged',unaffected(original,final))
    stable=all(hashlib.sha256((REPO/line.split('  ',1)[1]).read_bytes()).hexdigest()==line.split('  ',1)[0] for line in manifest.splitlines());check('runtime-inputs-stable',stable)
    result['overall']='PASS'
except Exception as e:
    result['overall']='FAIL';result['error']=scrub(type(e).__name__+': '+str(e));save(EV/'failure.txt',traceback.format_exc());print(result['error'],flush=True)
finally:
    for p in reversed(processes):stop(p)
    if server is not None:
        if server.poll() is None:
            try:command([MYSQL/'mysqladmin.exe','--no-defaults','--no-login-paths','--protocol=TCP','--host=127.0.0.1',f'--port={mysqlport}','--user=root','shutdown'],env=env,timeout=15)
            except Exception:pass
        stop(server)
    for h in handles:h.close()
    for p in private_files:
        if p.exists():p.unlink()
    result['tracked_processes_stopped']=all(p.poll() is not None for p in processes) and (server is None or server.poll() is not None)
    save(EV/'result.json',json.dumps(result,ensure_ascii=False,indent=2))
    for log in BASE.glob('*.log'):save(EV/log.name,log.read_text(encoding='utf-8',errors='replace'))
    print('RESULT '+str(EV/'result.json'),flush=True)
if result['overall']!='PASS':raise SystemExit(1)

