    wrong=Client();r,_,_=login(wrong,8081,'alice',name='wrong-end-customer');assert_page(r,200,'customer-cannot-admin');is_login_redirect(wrong.get('/categories',8081),'customer-no-admin-session')
    cl=Client();r,_,_=login(cl,8081,name='admin');check('admin-login-303',r[0]==303)
