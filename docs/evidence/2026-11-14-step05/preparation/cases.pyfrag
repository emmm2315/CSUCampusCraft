    no_op=dict(edit,version=str(p['version']))
    before=product(pid);write(cl,'/products/'+str(pid),no_op,303,'no-op-edit',back='/products/'+str(pid)+'/edit');check('no-op-version-and-row',product(pid)==before)
    write(cl,'/products/'+str(pid),edit,409,'stale-version-edit',back='/products/'+str(pid)+'/edit')
