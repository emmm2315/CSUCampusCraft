    for code in ['','Q'*22]:
        write(cl,'/categories',{'code':code,'name':'非法编码','sortOrder':''},400,'invalid-code-length-'+str(len(code)))
    for form in [{'code':'X','name':''},{'code':'X','name':'N'*51},{'code':'X','name':'bad sort','sortOrder':'-1'},{'code':'X','name':'bad sort','sortOrder':'2147483648'}]:
